# MCPeek - Static file serving with CORS support

RewriteEngine On

# Serve index.html for directory requests
DirectoryIndex index.html

# Allow CORS for all origins (needed for testing MCP servers)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Accept, mcp-protocol-version"
</IfModule>

# CSP for the main app (index.html) - restrictive
<Files "index.html">
    <IfModule mod_headers.c>
        Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src *"
    </IfModule>
</Files>

# No CSP for the proxy - MCP apps need to load external resources
<Files "mcp-app-proxy.php">
    <IfModule mod_headers.c>
        Header always unset Content-Security-Policy
    </IfModule>
</Files>

# Handle preflight OPTIONS requests
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ - [R=200,L]
</IfModule>
